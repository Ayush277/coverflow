# ── CoverFlow environment ────────────────────────────────────────────────────
# API (services/api)
PORT=4000
JWT_SECRET=change-me-in-production
WEB_ORIGIN=http://localhost:3000
# Optional: real OpenAI generation for the assistant (falls back to grounded composer)
OPENAI_API_KEY=
# Optional: FastAPI AI microservice for OCR/RAG (falls back to built-in extractor)
AI_SERVICE_URL=http://localhost:8000
# Optional: real Google OAuth (falls back to demo identity)
GOOGLE_CLIENT_ID=
# Optional: real email delivery (falls back to an Ethereal preview inbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CoverFlow <notifications@coverflow.app>"

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production stack (infra/docker-compose.yml)
POSTGRES_USER=coverflow
POSTGRES_PASSWORD=coverflow
POSTGRES_DB=coverflow
REDIS_URL=redis://redis:6379
GOOGLE_PUBSUB_PROJECT=coverflow-local
GOOGLE_PUBSUB_EMULATOR_HOST=pubsub:8681
