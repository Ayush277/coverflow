{
  "name": "coverflow",
  "private": true,
  "version": "1.0.0",
  "description": "CoverFlow — Benefit Intelligence Platform",
  "workspaces": [
    "apps/*",
    "services/api"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace services/api",
    "dev:web": "npm run dev --workspace apps/web",
    "seed": "npm run seed --workspace services/api",
    "build": "npm run build --workspace apps/web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
